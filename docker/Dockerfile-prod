# 1. ESTABILIDAD: Usamos Debian 12 (Bookworm) estable
FROM debian:bookworm-slim

# 2. VARIABLES DE ENTORNO: Agrupadas para crear menos capas en Docker.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=America/Mexico_City \
    PATH="/opt/venv/bin:$PATH"

# 3. ZONA HORARIA Y DEPENDENCIAS DEL SISTEMA
# Usamos --no-install-recommends para evitar instalar basura innecesaria y reducir peso.
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
    apt-get update && apt-get install -y --no-install-recommends \
    apache2 \
    python3 \
    python3-pip \
    python3-venv \
    libmariadb-dev \
    libapache2-mod-wsgi-py3 \
    pkg-config \
    gcc \
    chromium \
    chromium-driver \
    fonts-liberation \
    libnss3 \
    libxss1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libgtk-3-0 \
    libcairo2-dev \
    python3-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 4. CONFIGURACIÓN DE APACHE Y PUERTOS
RUN printf "Listen 8000\n" > /etc/apache2/ports.conf 

# 5. DIRECTORIO DE TRABAJO Y ENTORNO VIRTUAL
WORKDIR /app
RUN python3 -m venv /opt/venv

# 6. CACHÉ DE DEPENDENCIAS: Copiamos el archivo específico de producción
COPY ./requirements-prod.txt /app/

# Instalamos apuntando al archivo correcto
RUN pip install --upgrade pip --no-cache-dir && \
    pip install -r requirements-prod.txt --no-cache-dir

# 7. Copiar el código de la aplicación
COPY . /app/

# 8. Copiar la configuración de Apache para WSGI
# Según tu estructura, el archivo está en la carpeta "docker/" y se llama "apache.conf"
COPY ./docker/apache.conf /etc/apache2/sites-available/000-default.conf

# 9. SEGURIDAD: Asignar permisos al usuario de Apache (www-data)
RUN chown -R www-data:www-data /app /opt/venv /var/www /var/log/apache2 /var/run/apache2

# Exponemos el puerto
EXPOSE 8000

# 10. INICIO: Corremos Apache en primer plano
CMD ["apachectl", "-D", "FOREGROUND"]